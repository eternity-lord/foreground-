[
  {
    "id": "dialogue_ch1",
    "chapter": 1,
    "title": {
      "en": "Prologue: The Drawn Blade",
      "fa": "باب ۱: شمشیر کشیده"
    },
    "bg": "zone_01",
    "lines": [
      {
        "speaker": "KAI",
        "text": {
          "en": "Where… where am I?",
          "fa": "کجای… کجای من است؟"
        },
        "expression": "neutral"
      },
      {
        "speaker": "VULCAN",
        "text": {
          "en": "You are in Aetherion, Kai. And you are my heir now.",
          "fa": "شما در آثيريون هستید، کای. و حالا وارث من هستید."
        },
        "expression": "neutral"
      },
      {
        "speaker": "KAI",
        "text": {
          "en": "I never asked to be a smith.",
          "fa": "من هرگز آهنگر شدن را نخواستم."
        },
        "expression": "neutral"
      }
    ]
  },
  {
    "id": "dialogue_ch2",
    "chapter": 2,
    "title": {
      "en": "First Heat",
      "fa": "باب ۲: گرمای اول"
    },
    "bg": "zone_02",
    "lines": [
      {
        "speaker": "KAI",
        "text": {
          "en": "The ingot won't stay in the green zone.",
          "fa": "آهن داغ در نطاق سبز نمی‌مند."
        },
        "expression": "neutral"
      },
      {
        "speaker": "VULCAN",
        "text": {
          "en": "Patience. The metal speaks if you listen.",
          "fa": "صبر. فلز می‌گوید اگر گوش کنید."
        },
        "expression": "neutral"
      }
    ]
  },
  {
    "id": "dialogue_ch3",
    "chapter": 3,
    "title": {
      "en": "The Seven Techniques",
      "fa": "باب ۳: هفت تکنیک"
    },
    "bg": "zone_03",
    "lines": [
      {
        "speaker": "KAI",
        "text": {
          "en": "Seven techniques to forge the impossible.",
          "fa": "هفت تکنیک برای آهنساختن ناممکن."
        },
        "expression": "neutral"
      }
    ]
  },
  {
    "id": "dialogue_ch4",
    "chapter": 4,
    "title": {
      "en": "Allies of Aetherion",
      "fa": "باب ۴: رفیقان آثيريون"
    },
    "bg": "zone_04",
    "lines": [
      {
        "speaker": "LYRA",
        "text": {
          "en": "I'll watch your back.",
          "fa": "من پشت شما را می‌دارم."
        },
        "expression": "neutral"
      },
      {
        "speaker": "MINA",
        "text": {
          "en": "And I'll keep the fire burning.",
          "fa": "و من آتش را تاب می‌آورم."
        },
        "expression": "neutral"
      }
    ]
  },
  {
    "id": "dialogue_ch5",
    "chapter": 5,
    "title": {
      "en": "Emberdeep Betrayal",
      "fa": "باب ۵: خيانة امبردیپ"
    },
    "bg": "zone_05",
    "lines": [
      {
        "speaker": "TORIN",
        "text": {
          "en": "The Rust King corrupts every blade.",
          "fa": "پادشاه زنگ هر تلوار را آلوده می‌کند."
        },
        "expression": "neutral"
      }
    ]
  },
  {
    "id": "dialogue_ch6",
    "chapter": 6,
    "title": {
      "en": "Skyforge Fallen",
      "fa": "باب ۶: آسمان‌ساز>"
    },
    "bg": "zone_06",
    "lines": [
      {
        "speaker": "DARI",
        "text": {
          "en": "The sky is falling in shards.",
          "fa": "آسمان در تکه‌تکه می‌افتد."
        },
        "expression": "neutral"
      }
    ]
  },
  {
    "id": "dialogue_ch7",
    "chapter": 7,
    "title": {
      "en": "Crimson Oath",
      "fa": "باب ۷: قسم قرمز"
    },
    "bg": "zone_07",
    "lines": [
      {
        "speaker": "KAI",
        "text": {
          "en": "I swear on Vulcan's anvil.",
          "fa": "من بر سنگساختن وولکان قسم می‌خورم."
        },
        "expression": "neutral"
      }
    ]
  },
  {
    "id": "dialogue_ch8",
    "chapter": 8,
    "title": {
      "en": "The Void Between",
      "fa": "باب ۸: میان‌فضا"
    },
    "bg": "zone_08",
    "lines": [
      {
        "speaker": "VULCAN",
        "text": {
          "en": "Beyond the rift lies the true ending.",
          "fa": "پایان واقعی در شکافت باقی می‌مند."
        },
        "expression": "neutral"
      }
    ]
  },
  {
    "id": "dialogue_ch9",
    "chapter": 9,
    "title": {
      "en": "Throne of Rust",
      "fa": "باب ۹: تخت زنگ"
    },
    "bg": "zone_09",
    "lines": [
      {
        "speaker": "RUST_KING",
        "text": {
          "en": "All metal bows to rust.",
          "fa": "تمام فلزها به زنگ می‌نشینند."
        },
        "expression": "neutral"
      }
    ]
  },
  {
    "id": "dialogue_ch10",
    "chapter": 10,
    "title": {
      "en": "The Last Strike",
      "fa": "باب ۱۰: ضربه آخر"
    },
    "bg": "zone_10",
    "lines": [
      {
        "speaker": "KAI",
        "text": {
          "en": "This hammer ends the Rust King.",
          "fa": "چاقو نهایی پادشاه زنگ را می‌شکند."
        },
        "expression": "neutral"
      }
    ]
  },
